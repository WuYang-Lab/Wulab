# ============================================================================
# wulab 站点 .gitignore
#
# 原则：只有"手写的源码"和"站点要用的静态资源"进仓库，其余一概忽略。
# 判断标准（满足任一条就 ignore）：
#   1. 能再生的          -> node_modules、dist（npm install / npm run build 就有）
#   2. 含密钥的          -> .env.local（里面是 GITHUB_TOKEN）
#   3. 本机工具产生的    -> 编辑器配置、助手缓存、日志
#   4. 操作系统产生的    -> .DS_Store、Thumbs.db
# ============================================================================


# ---------------------------------------------------------------------------
# 依赖与构建产物（可完全再生，体积又大，绝不入库）
# ---------------------------------------------------------------------------
node_modules/
/dist
dist/
.cache/
coverage/
*.tsbuildinfo


# ---------------------------------------------------------------------------
# 环境变量与密钥（.env.local 里有 GITHUB_TOKEN，泄露 = 别人可代你提 issue）
# 需要给协作者看的就提交 .env.example，真实值一律本地
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore


# ---------------------------------------------------------------------------
# 本机工具 / AI 助手缓存
# .workbuddy/ 目前 300MB+，含会话记录和预览日志，属于纯粹的本地数据
# ---------------------------------------------------------------------------
.workbuddy/
.claude/
.cursor/
.trae/
.aider*


# ---------------------------------------------------------------------------
# 日志与临时文件
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.seed
*.tmp
*.temp
*.bak
*.orig
*.rej
*~
~$*


# ---------------------------------------------------------------------------
# 操作系统
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini


# ---------------------------------------------------------------------------
# 编辑器 / IDE
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


# ---------------------------------------------------------------------------
# 例外说明（不要加进上面的忽略规则）
#   public/software/OPERA/download/OPERA.zip  12.6MB，站点下载按钮直接链接它，
#                                             必须留在仓库里。
#                                             以后若要瘦身，可改为挂 GitHub Release，
#                                             再同步修改 opera.tpl.html 里的链接。
#   src/assets/**                            所有插图/成员照，站点构建需要。
# ---------------------------------------------------------------------------
